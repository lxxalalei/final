# platform-search 本地环境模板
#
# 使用方式：
#   1. 复制为 platform-search/.env、platform-search/.env.local、项目根目录 .env 或项目根目录 .env.local
#   2. 只在本地填入真实 Cookie/Token
#   3. 不要把 .env 或 .env.local 提交到仓库

# ── 通用搜索增强 ──────────────────────────────────
# Bing/Baidu/DuckDuckGo 不需要登录；Cookie 只用于降低验证页概率。
BING_COOKIE=
BAIDU_COOKIE=
DUCKDUCKGO_COOKIE=

# Jina 可无密钥使用；配置后通常有更高限额。
JINA_API_KEY=

# GitHub 公共仓库搜索可无 Token；配置后提高速率限制。
GITHUB_TOKEN=
GH_TOKEN=

# ── 学习资源平台 ──────────────────────────────────
BILIBILI_COOKIE=
BILIBILI_COOKIE_FILE=
XIMALAYA_COOKIE=
OPEN163_COOKIE=
SOGOU_WEIXIN_COOKIE=
ANNAS_BASE_URL=
ANNAS_AUTO_BASE_URL=
ANNAS_FALLBACK=
ANNAS_FALLBACK_ENGINES=

# 国家智慧教育平台：优先使用 Cookie/Authorization/Headers。
SMARTEDU_ACCESS_TOKEN=
SMARTEDU_COOKIE=
SMARTEDU_AUTHORIZATION=
SMARTEDU_HEADERS=
SMARTEDU_SDP_APP_ID=
SMARTEDU_BROWSER_EXECUTABLE=

# ── 需要登录态的平台 ───────────────────────────────
# 建议复制浏览器 Request Headers 里的整段 Cookie。
# 直连知乎搜索 API 至少需要 z_c0 和 d_c0。
ZHIHU_COOKIE=
ZHIHU_COOKIE_FILE=
ZHIHU_TOKEN=

DOUYIN_COOKIE=
DOUYIN_COOKIE_FILE=

WEIBO_COOKIE=
WEIBO_COOKIE_FILE=
