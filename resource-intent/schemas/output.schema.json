{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intent-brief/v1",
  "title": "Clarified child learning resource need",
  "type": "object",
  "required": ["_meta", "_summary", "data"],
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": ["statement", "quote"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "requirementItem": {
      "type": "object",
      "required": ["text", "strength", "evidence"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "strength": {"enum": ["must", "prefer", "exclude"]},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["schema_version", "session_id", "created_at"],
      "properties": {
        "schema_version": {"const": "intent-brief/v1"},
        "session_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "_summary": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["ready", "needs_clarification"]},
        "question": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "needs_clarification"}}},
          "then": {"required": ["question"]}
        },
        {
          "if": {"properties": {"status": {"const": "ready"}}},
          "then": {"not": {"required": ["question"]}}
        }
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["status", "raw_request", "clarified_need", "evidence", "requirements"],
      "properties": {
        "status": {"enum": ["ready", "needs_clarification"]},
        "raw_request": {"type": "string", "minLength": 1},
        "clarified_need": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidenceItem"}
        },
        "requirements": {
          "type": "array",
          "items": {"$ref": "#/$defs/requirementItem"}
        },
        "assumptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "clarification": {
          "type": "object",
          "required": ["question", "reason"],
          "properties": {
            "question": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ready"}}},
          "then": {
            "properties": {"evidence": {"minItems": 1}},
            "not": {"required": ["clarification"]}
          }
        },
        {
          "if": {"properties": {"status": {"const": "needs_clarification"}}},
          "then": {"required": ["clarification"]}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
