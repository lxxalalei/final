{
  "schema_version": "intent-brief-golden/v1",
  "cases": [
    {
      "id": "broad-primary-math-needs-anchor",
      "request": "帮我找一些小学数学资料",
      "expect": {
        "status": "needs_clarification",
        "brief_contains": ["小学数学", "范围"],
        "question_mentions_any": ["年级", "知识点", "整个小学阶段"]
      }
    },
    {
      "id": "explicit-full-range-exploration",
      "request": "覆盖整个小学阶段的数学资源，先看看有哪些类型",
      "expect": {
        "status": "ready",
        "brief_contains": ["整个小学阶段", "资源概览"],
        "must_not_clarify": ["年级", "知识点"]
      }
    },
    {
      "id": "explicit-grade-math-course",
      "request": "四年级数学课程",
      "expect": {
        "status": "ready",
        "brief_contains": ["四年级", "数学课程"],
        "brief_forbids": ["系统学习", "中文", "人教版"]
      }
    },
    {
      "id": "audio-scenario-inference",
      "request": "想找些孩子上学路上听的英语启蒙内容",
      "expect": {
        "status": "ready",
        "brief_contains": ["英语启蒙", "上学路上", "收听"]
      }
    },
    {
      "id": "ambiguous-directed-programming",
      "request": "给孩子找一套马上可以开始学的编程课程",
      "expect": {
        "status": "needs_clarification",
        "question_mentions_any": ["Scratch", "Python", "机器人"]
      }
    },
    {
      "id": "broad-programming-discovery",
      "request": "先看看儿童编程有哪些学习资源",
      "expect": {
        "status": "ready",
        "brief_contains": ["儿童编程", "资源概览"],
        "must_not_clarify": ["Scratch", "Python", "机器人"]
      }
    },
    {
      "id": "user-delegates-format",
      "request": "想找点恐龙科普，形式都可以",
      "expect": {
        "status": "ready",
        "brief_contains": ["恐龙科普", "不限定资源形式"],
        "requirements": []
      }
    },
    {
      "id": "must-free-prefer-official",
      "request": "只要免费的，最好是官方的小学安全教育资源",
      "expect": {
        "status": "ready",
        "requirements": [
          {"text_contains": "免费", "strength": "must"},
          {"text_contains": "官方", "strength": "prefer"}
        ]
      }
    },
    {
      "id": "exclude-video",
      "request": "不要视频，找二年级语文阅读理解材料",
      "expect": {
        "status": "ready",
        "brief_contains": ["二年级", "语文阅读理解"],
        "requirements": [
          {"text_contains": "视频", "strength": "exclude"}
        ]
      }
    },
    {
      "id": "version-explicit",
      "request": "人教版五年级上册数学同步练习",
      "expect": {
        "status": "ready",
        "brief_contains": ["人教版", "五年级上册", "数学同步练习"]
      }
    },
    {
      "id": "age-grade-conflict",
      "request": "给6岁的四年级孩子找数学同步课",
      "expect": {
        "status": "needs_clarification",
        "question_mentions_any": ["6岁", "四年级", "以哪个为准"]
      }
    },
    {
      "id": "no-learning-content",
      "request": "帮我找点学习资源",
      "expect": {
        "status": "needs_clarification",
        "question_mentions_any": ["学科", "主题", "能力"]
      }
    },
    {
      "id": "problem-with-specific-content",
      "request": "孩子做应用题总是不知道从哪下手",
      "expect": {
        "status": "ready",
        "brief_contains": ["应用题"],
        "brief_forbids": ["审题方法", "学习习惯", "粗心"]
      }
    },
    {
      "id": "vague-math-problem",
      "request": "孩子数学不太好，想补一补",
      "expect": {
        "status": "needs_clarification",
        "question_mentions_any": ["计算", "应用题", "数学概念"]
      }
    },
    {
      "id": "exhaustive-mode-natural-language",
      "request": "把适合小学生的天文科普资源尽量全面地找一下",
      "expect": {
        "status": "ready",
        "brief_contains": ["小学生", "天文科普", "尽量全面"]
      }
    },
    {
      "id": "english-language-stays-open",
      "request": "找英语启蒙资源",
      "expect": {
        "status": "ready",
        "brief_contains": ["英语启蒙"],
        "brief_forbids": ["必须全英文", "中文讲解"]
      }
    },
    {
      "id": "constraint-conflict-media",
      "request": "不要视频，最好找动画讲解",
      "expect": {
        "status": "needs_clarification",
        "question_mentions_any": ["完全不要视频", "接受动画"]
      }
    },
    {
      "id": "sensitive-topic-age-matters",
      "request": "想找儿童身体边界教育资源",
      "expect": {
        "status": "needs_clarification",
        "question_mentions_any": ["年龄", "适龄"]
      }
    },
    {
      "id": "independent-multiple-goals",
      "request": "想找三年级数学练习，也想找儿童画教程",
      "expect": {
        "status": "ready",
        "brief_contains": ["三年级数学练习", "儿童画教程"]
      }
    },
    {
      "id": "explicit-file-format-and-resource-form",
      "request": "找五年级数学 PDF 试卷，最好也有 PPT 讲解课件",
      "expect": {
        "status": "ready",
        "brief_contains": ["五年级数学", "PDF试卷"],
        "requirements": [
          {"text_contains": "PPT讲解课件", "strength": "prefer"}
        ]
      }
    },
    {
      "id": "printable-not-file-format",
      "request": "找可打印的二年级口算题卡",
      "expect": {
        "status": "ready",
        "brief_contains": ["二年级口算题卡", "可打印"],
        "brief_forbids": ["PDF格式"]
      }
    },
    {
      "id": "learning-habit-needs-supported-content",
      "request": "找些资源帮孩子改掉拖拉写作业的习惯",
      "expect": {
        "status": "needs_clarification",
        "brief_forbids": ["时间管理课程", "学习习惯训练"],
        "question_mentions_any": ["学科", "主题", "能力"]
      }
    },
    {
      "id": "learning-method-needs-supported-content",
      "request": "找一套教孩子做阅读笔记的方法",
      "expect": {
        "status": "needs_clarification",
        "brief_forbids": ["阅读理解资源"],
        "question_mentions_any": ["学科", "主题", "能力"]
      }
    },
    {
      "id": "problem-plus-concrete-content",
      "request": "孩子总粗心，想找二年级口算练习",
      "expect": {
        "status": "ready",
        "brief_contains": ["二年级口算练习"],
        "brief_forbids": ["粗心训练", "检查习惯"]
      }
    }
  ]
}
