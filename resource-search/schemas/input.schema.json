{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-input/v1",
  "title": "Validated intent input for search planning",
  "type": "object",
  "required": ["_meta", "_summary", "data"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["schema_version", "session_id", "created_at"],
      "properties": {
        "schema_version": {"const": "intent-brief/v1"},
        "session_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "_summary": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"const": "ready"}
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["status", "raw_request", "clarified_need", "evidence", "requirements"],
      "properties": {
        "status": {"const": "ready"},
        "raw_request": {"type": "string", "minLength": 1},
        "clarified_need": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "quote"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "quote": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "strength", "evidence"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "strength": {"enum": ["must", "prefer", "exclude"]},
              "evidence": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
