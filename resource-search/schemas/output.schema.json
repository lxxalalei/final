{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-plan/v1",
  "title": "Executable search plan",
  "type": "object",
  "required": ["_meta", "_summary", "data"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["stage", "session_id", "skill", "created_at", "input_from", "schema_version"],
      "properties": {
        "stage": {"const": 2},
        "session_id": {"type": "string", "minLength": 1},
        "skill": {"const": "resource-search"},
        "created_at": {"type": "string", "minLength": 1},
        "input_from": {"const": "stage1_intent.json"},
        "schema_version": {"const": "search-plan/v1"}
      },
      "additionalProperties": false
    },
    "_summary": {
      "type": "object",
      "required": ["platform_count", "platforms", "query_count", "expected_results"],
      "properties": {
        "platform_count": {"type": "integer", "minimum": 1},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "query_count": {"type": "integer", "minimum": 1},
        "expected_results": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["schema_version", "intent_ref", "strategy", "search_tasks"],
      "properties": {
        "schema_version": {"const": "search-plan/v1"},
        "intent_ref": {"const": "stage1_intent.json"},
        "strategy": {"type": "string", "minLength": 1},
        "search_tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["task_id", "platform", "priority", "reason", "searches"],
            "properties": {
              "task_id": {"type": "string", "pattern": "^task-[a-z0-9-]+$"},
              "platform": {"type": "string", "minLength": 1},
              "priority": {"enum": ["P0", "P1", "P2"]},
              "reason": {"type": "string", "minLength": 1},
              "searches": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["query", "max_results", "params"],
                  "properties": {
                    "query": {"type": "string", "minLength": 1},
                    "max_results": {"type": "integer", "minimum": 1, "maximum": 100},
                    "params": {"type": "object"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
